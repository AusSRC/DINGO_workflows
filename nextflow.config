includeConfig 'pipeline_components/nextflow/config/images.config'
includeConfig 'pipeline_components/nextflow/config/setonix.config'

profiles {
    setonix {
        workDir = '/scratch/ja3/dingo_survey/work/'
        tmpDir = '/scratch/ja3/dingo_survey/tmp/'

        process {
            cache = 'lenient'
            stageInMode = 'symlink'

            withName: download {
                executor = 'slurm'
                queue = 'copy'
                clusterOptions = '--account=ja3 --time=6:00:00'
            }

            withName: sofia {
                executor = 'slurm'
                queue = 'work'
                clusterOptions = '--mem=128G --account=ja3 --time=12:00:00'
            }
        }

        env {
            PYTHONNOUSERSITE = "1"
        }

        params {
            WORKDIR = "/scratch/ja3/dingo_survey"
            CONFIG_DIR = "/software/projects/ja3/ashen/config/dingo"
            RUN_DIR = "run"
            ASTROPY_CACHEDIR = "/scratch/ja3/dingo_survey"

            DATABASE_ENV = "$CONFIG_DIR/database.env"
            CASDA_CREDENTIALS = "$CONFIG_DIR/casda.ini"

            SOFIA_PARAMETER_FILE = "$CONFIG_DIR/sofia.par"
            SOFIA_CATALOG = "$CONFIG_DIR/concat_gt_150_mJy.dat"
            SOFIAX_CONFIG_FILE = "$CONFIG_DIR/sofiax.ini"
            S2P_TEMPLATE = "$CONFIG_DIR/s2p_setup.ini"

            VALIDATE_WORK_DIR = "$WORKDIR/validate/working"
        }
    }
}

params {
    METADATA_SUBDIR = "metadata"
    FOOTPRINT_SUBDIR = "data/footprints"
    MOSAICS_SUBDIR = "data/mosaics"

    MOSAIC_OUTPUT_FILENAME = "mosaic"
    SOFIA_OUTPUTS_DIRNAME = "outputs"
    SOFIAX_CONFIG_FILENAME = "sofiax.ini"
    WALLMERGE_OUTPUT = "mom0.fits"
    DIAGNOSTIC_PLOT_FILENAME = "diagnostics.pdf"
    REGION = ""
    RUN_SOFIA = "1"
    RUN_SOFIAX = "1"

    AUSSRC_TOOLS_IMAGE = "aussrc/aussrc_tools:dev"
}
